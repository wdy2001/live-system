# 复制为 .env 并修改为你的本地配置
# 运行环境: development / testing / production
FLASK_ENV=development

# Flask 密钥（用于 session 等，请改为随机字符串）
SECRET_KEY=change-this-to-a-random-secret-key

# JWT 密钥（请改为随机字符串）
# 注意: 代码中使用 JWT_SECRET_KEY；JWT_SECRET 为兼容别名，设置其一即可
JWT_SECRET=change-this-to-a-random-jwt-secret-key
JWT_SECRET_KEY=change-this-to-a-random-jwt-secret-key

# JWT Token 过期时间（秒，默认 7 天 = 604800）
# JWT_ACCESS_TOKEN_EXPIRES=604800

# 数据库配置
# 方式一：直接指定完整数据库连接 URL（优先级最高）
# DATABASE_URL=sqlite:///life_system.db
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/life_system?charset=utf8mb4

# 方式二：通过 USE_SQLITE 和各参数组合构建
# 默认使用 MySQL，如需使用 SQLite（开发测试，无需 MySQL），将 USE_SQLITE 设为 true
USE_SQLITE=false

# MySQL 连接配置（USE_SQLITE=false 且未设置 DATABASE_URL 时使用）
DB_HOST=localhost
DB_PORT=3306
DB_USER=change-this-to-your-db-user
DB_PASSWORD=change-this-to-your-db-password
DB_NAME=life_system
