# 复制为 .env 并修改为你的本地配置
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret
JWT_SECRET_KEY=change-this-to-a-jwt-random-secret

# 数据库配置
# 默认使用 MySQL，如需使用 SQLite（开发测试，无需 MySQL），将 USE_SQLITE 设为 true
USE_SQLITE=false

# MySQL 连接配置（USE_SQLITE=false 时使用）
DB_HOST=localhost
DB_PORT=3306
DB_USER=life_app
DB_PASSWORD=life_pass_2026
DB_NAME=life_system

# SQLite 配置（USE_SQLITE=true 时使用，数据库文件在 backend 目录下）
# USE_SQLITE=true
